{
  "name": "cowait-cli",
  "version": "1.0.0",
  "description": "Cowait for Claude Code: a terminal side panel that shows what each turn changed, relays one-line notes to Claude without interrupting it, and fills the wait with a daily puzzle, a card game or flashcards.",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && vitest run",
    "compile": "node scripts/compile.mjs",
    "media": "node scripts/media/record.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "cli",
    "tui",
    "ai-agent",
    "developer-tools",
    "code-review",
    "roguelike",
    "puzzle",
    "flashcards",
    "ai-code-review"
  ],
  "author": "Zhaobin Xu (JaspinXu)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "bin": {
    "cowait": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaspinXu/Cowait.git"
  },
  "homepage": "https://github.com/JaspinXu/Cowait#readme"
}
